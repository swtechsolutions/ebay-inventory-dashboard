# Ignore SQLite Database Files (keeps your personal data private)
*.db
*.sqlite
*.sqlite3

# Ignore Uploaded Product Images
uploads/
!uploads/.gitkeep

# Ignore Python Cache Files & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# Ignore Environment Variable Files (for future API keys/passwords)
.env