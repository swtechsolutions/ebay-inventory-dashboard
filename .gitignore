# Ignore SQLite Database Files (keeps personal data private)
*.db
*.sqlite
*.sqlite3

# Ignore Uploaded Product Images inside static/uploads
static/uploads/*
!static/uploads/.gitkeep

# Ignore Python Cache Files & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# Ignore Environment Variable Files (for future API keys/passwords)
.env